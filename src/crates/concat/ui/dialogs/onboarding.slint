import { I18n } from "../i18n.slint";
import { Theme } from "../theme/theme.slint";
import { Glyph, Icon } from "../icons.slint";
import { Button, Modal, Progress } from "../primitives/modal.slint";

// Знакомство при первом запуске: одно окно, три экрана.
//
// Первый показывает четыре части окна, второй выбирает цель одним кликом,
// третий предлагает модель распознавания. «Пропустить» доступно всегда, а
// «Дальше» → цель → «Готово» — это три клика.

/// Состояние знакомства, как его публикует Rust.
export struct OnboardingData {
    open: bool,
    /// 0 приветствие, 1 цель, 2 снаряжение.
    step: int,
    /// Выбранная цель: "vertical", "youtube", "edit" или пусто.
    goal: string,
    /// Имя уже имеющейся модели; пусто, когда её нет.
    aboard: string,
    /// Модель, которую предлагаем скачать.
    model-name: string,
    model-size: string,
    downloading: bool,
    /// 0..1.
    progress: float,
    /// "12 MB of 148 MB"
    transferred: string,
    error: string,
}

// Карточка одного экрана: знак, заголовок и строка под ним. Нажимается
// целиком — выбор цели идёт одним кликом.
component TourCard inherits Rectangle {
    in property <string> title;
    in property <string> hint;
    in property <Glyph> glyph;
    in property <bool> chosen;

    callback clicked();

    accessible-role: button;
    accessible-label: root.title;

    min-height: 58px;
    horizontal-stretch: 1;
    border-radius: Theme.r-lg;
    background: root.chosen ? Theme.accent-soft
        : touch.has-hover ? Theme.field-hover
        : Theme.field;
    border-width: 1px;
    border-color: root.chosen ? Theme.accent : Theme.line;

    animate background, border-color { duration: 120ms; easing: cubic-bezier(0.4, 0, 0.2, 1); }

    HorizontalLayout {
        padding: 12px;
        spacing: 10px;

        VerticalLayout {
            alignment: center;
            Icon {
                glyph: root.glyph;
                size: 18px;
                tint: root.chosen ? Theme.accent : Theme.fg-muted;
            }
        }

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: 2px;

            Text {
                text: root.title;
                color: Theme.fg;
                font-size: Theme.fs-lg;
                font-weight: Theme.weight-title;
                overflow: elide;
            }

            Text {
                text: root.hint;
                color: Theme.fg-muted;
                font-size: Theme.fs-sm;
                wrap: word-wrap;
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component OnboardingDialog inherits Modal {
    in property <OnboardingData> data;

    callback skipped();
    callback next();
    callback back();
    callback goal-chosen(goal: string);
    callback download();
    callback cancel();
    callback done();

    open: root.data.open;
    title: root.data.step == 0 ? I18n.t("onboarding.welcomeTitle")
        : root.data.step == 1 ? I18n.t("onboarding.goalTitle")
        : I18n.t("onboarding.gearTitle");
    glyph: Glyph.sparkle;
    surface-width: 560px;
    // «Пропустить» доступно всегда, но сбежать из-под скачивания нельзя:
    // отмена скачивания и есть уход.
    dismissable: true;

    // Внешнее закрытие крестиком — то же, что «Пропустить».
    closed => { root.skipped(); }

    VerticalLayout {
        // ── экран 1: приветствие ────────────────────────────────────────
        if root.data.step == 0: VerticalLayout {
            padding-left: 18px;
            padding-right: 18px;
            padding-top: 4px;
            padding-bottom: 18px;
            spacing: 10px;

            Text {
                text: I18n.t("onboarding.welcomeBody");
                color: Theme.fg-muted;
                font-size: Theme.fs;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: 10px;

                TourCard {
                    glyph: Glyph.film;
                    title: I18n.t("onboarding.media");
                    hint: I18n.t("onboarding.mediaHint");
                }

                TourCard {
                    glyph: Glyph.image;
                    title: I18n.t("onboarding.monitor");
                    hint: I18n.t("onboarding.monitorHint");
                }
            }

            HorizontalLayout {
                spacing: 10px;

                TourCard {
                    glyph: Glyph.rows;
                    title: I18n.t("onboarding.timeline");
                    hint: I18n.t("onboarding.timelineHint");
                }

                TourCard {
                    glyph: Glyph.settings;
                    title: I18n.t("onboarding.inspector");
                    hint: I18n.t("onboarding.inspectorHint");
                }
            }
        }

        // ── экран 2: цель ──────────────────────────────────────────────
        if root.data.step == 1: VerticalLayout {
            padding-left: 18px;
            padding-right: 18px;
            padding-top: 4px;
            padding-bottom: 18px;
            spacing: 10px;

            Text {
                text: I18n.t("onboarding.goalBody");
                color: Theme.fg-muted;
                font-size: Theme.fs;
                wrap: word-wrap;
            }

            TourCard {
                glyph: Glyph.frame;
                title: I18n.t("onboarding.goalVertical");
                hint: I18n.t("onboarding.goalVerticalHint");
                chosen: root.data.goal == "vertical";
                clicked => { root.goal-chosen("vertical"); }
            }

            TourCard {
                glyph: Glyph.film;
                title: I18n.t("onboarding.goalYoutube");
                hint: I18n.t("onboarding.goalYoutubeHint");
                chosen: root.data.goal == "youtube";
                clicked => { root.goal-chosen("youtube"); }
            }

            TourCard {
                glyph: Glyph.razor;
                title: I18n.t("onboarding.goalEdit");
                hint: I18n.t("onboarding.goalEditHint");
                chosen: root.data.goal == "edit";
                clicked => { root.goal-chosen("edit"); }
            }
        }

        // ── экран 3: снаряжение ─────────────────────────────────────────
        if root.data.step == 2: VerticalLayout {
            padding-left: 18px;
            padding-right: 18px;
            padding-top: 4px;
            padding-bottom: 18px;
            spacing: 12px;

            Text {
                text: I18n.t("onboarding.gearBody");
                color: Theme.fg-muted;
                font-size: Theme.fs;
                wrap: word-wrap;
            }

            if root.data.aboard != "": HorizontalLayout {
                spacing: 8px;

                VerticalLayout {
                    alignment: center;
                    Icon { glyph: Glyph.check; size: 15px; tint: Theme.green; }
                }

                Text {
                    horizontal-stretch: 1;
                    text: I18n.t1("onboarding.aboard", root.data.aboard);
                    color: Theme.green;
                    font-size: Theme.fs;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
            }

            if root.data.aboard == "" && root.data.model-name != "": Rectangle {
                border-radius: Theme.r;
                background: Theme.field;
                border-width: 1px;
                border-color: Theme.line;

                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;

                    HorizontalLayout {
                        spacing: 10px;

                        Text {
                            horizontal-stretch: 1;
                            text: root.data.model-name;
                            color: Theme.fg;
                            font-size: Theme.fs-lg;
                            font-weight: Theme.weight-title;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        Text {
                            text: root.data.model-size;
                            color: Theme.fg-dim;
                            font-family: Theme.font-technical;
                            font-size: Theme.fs-sm;
                            vertical-alignment: center;
                        }
                    }

                    if root.data.error != "": Text {
                        text: root.data.error;
                        color: Theme.danger;
                        font-size: Theme.fs-sm;
                        wrap: word-wrap;
                    }

                    if root.data.downloading: Progress {
                        value: root.data.progress;
                        live: true;
                    }

                    if root.data.downloading: Text {
                        text: root.data.transferred;
                        color: Theme.fg-muted;
                        font-family: Theme.font-technical;
                        font-size: Theme.fs-sm;
                    }

                    HorizontalLayout {
                        spacing: 8px;

                        if !root.data.downloading: Button {
                            label: I18n.t("onboarding.download");
                            glyph: Glyph.import;
                            primary: true;
                            clicked => { root.download(); }
                        }

                        if root.data.downloading: Button {
                            label: I18n.t("common.cancel");
                            glyph: Glyph.close;
                            ghost: true;
                            clicked => { root.cancel(); }
                        }
                    }
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.line;
        }

        // ── подвал ──────────────────────────────────────────────────────
        HorizontalLayout {
            padding: 14px;
            spacing: 8px;

            Button {
                label: I18n.t("onboarding.skip");
                ghost: true;
                clicked => { root.skipped(); }
            }

            Rectangle { horizontal-stretch: 1; }

            if root.data.step > 0: Button {
                label: I18n.t("onboarding.back");
                glyph: Glyph.chevron-left;
                ghost: true;
                clicked => { root.back(); }
            }

            if root.data.step == 0: Button {
                label: I18n.t("onboarding.next");
                primary: true;
                large: true;
                clicked => { root.next(); }
            }

            if root.data.step == 2 && root.data.aboard == "" && root.data.model-name != "": Button {
                label: I18n.t("onboarding.later");
                ghost: true;
                clicked => { root.done(); }
            }

            if root.data.step == 2: Button {
                label: I18n.t("onboarding.done");
                primary: true;
                large: true;
                clicked => { root.done(); }
            }
        }
    }
}
