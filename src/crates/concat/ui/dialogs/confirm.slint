import { I18n } from "../i18n.slint";
import { Theme } from "../theme/theme.slint";
import { Glyph } from "../icons.slint";
import { Button, Modal } from "../primitives/modal.slint";
import { Check } from "../inspector/controls.slint";

/// One question before something is thrown away, or a choice offered
/// before a video with several audio tracks goes down: what it is, what
/// goes with it, and the word on the button that does it. Rust fills it
/// and says what the answer means; the sheet knows nothing of clips.
export struct ConfirmData {
    open: bool,
    title: string,
    message: string,
    /// The button that goes ahead: "Delete".
    action: string,
    /// The words beside the tick box, or empty for a sheet with none.
    check-label: string,
    /// The tick box's state. The sheet only reports a press; what is bound
    /// back is what it draws, so the caller stays the one truth.
    checked: bool,
    /// True for the sheets that throw something away, which wear the bin's
    /// mark and the warning button; false is an ordinary choice.
    danger: bool,
}

// The confirmation sheet. Return goes ahead and Escape backs out, so a
// question asked from the keyboard is answered from it; a click on the
// scrim or the close backs out too.
export component ConfirmDialog inherits Modal {
    in property <ConfirmData> data;

    callback confirmed();
    callback dismissed();
    callback check-toggled(checked: bool);

    open: root.data.open;
    title: root.data.title;
    glyph: root.data.danger ? Glyph.trash : Glyph.waveform;
    surface-width: 400px;

    closed => { root.dismissed(); }

    // The keys go to the sheet the moment it shows, not to whatever had
    // focus under it.
    changed open => {
        if (root.open) {
            keys.focus();
        }
    }

    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.dismissed();
                return accept;
            }
            if (event.text == Key.Return) {
                root.confirmed();
                return accept;
            }
            reject
        }

        VerticalLayout {
            padding: 16px;
            spacing: 16px;

            Text {
                text: root.data.message;
                color: Theme.fg;
                font-size: Theme.fs;
                wrap: word-wrap;
            }

            if root.data.check-label != "": HorizontalLayout {
                spacing: 8px;

                VerticalLayout {
                    alignment: center;

                    Check {
                        checked: root.data.checked;
                        accessible-role: checkbox;
                        accessible-label: root.data.check-label;
                        toggled(checked) => { root.check-toggled(checked); }
                    }
                }

                Text {
                    text: root.data.check-label;
                    color: Theme.fg-muted;
                    font-size: Theme.fs;
                    vertical-alignment: center;
                }
            }

            HorizontalLayout {
                alignment: end;
                spacing: 8px;

                Button {
                    label: I18n.t("common.cancel");
                    clicked => { root.dismissed(); }
                }

                Button {
                    danger: root.data.danger;
                    label: root.data.action;
                    clicked => { root.confirmed(); }
                }
            }
        }
    }
}
